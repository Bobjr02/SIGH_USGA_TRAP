<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dados de demonstração FICTÍCIOS (Seed:DemoData), fora do projeto da API. O seeder só é registrado e executado com
    Seed:DemoData=true (e só em Development/Demo); sem isso nenhum tipo daqui, nem o OpenXml, chega a ser carregado.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIGH.Application\SIGH.Application.csproj" />
    <ProjectReference Include="..\SIGH.Persistence\SIGH.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT: gera as planilhas FICTÍCIAS da demonstração da Trapiche (nenhum dado real é versionado). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>

{
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Seed": {
    "DefaultCompanyName": "Usina Serra Grande S.A.",
    "Companies": {
      "USGA": {
        "Name": "Usina Serra Grande S.A.",
        "ManagementUnitPrefix": "USGA"
      },
      "TRAP": {
        "Name": "Trapiche",
        "ManagementUnitPrefix": "TRAP"
      }
    }
  },
  "JwtOptions": {
    "Issuer": "SIGH.Api",
    "Audience": "SIGH.Client",
    "ExpiryInMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "MaxUploadSizeBytes": 26214400,
    "Local": {
      "RootPath": ""
    }
  },
  "Auth": {
    "RefreshTokenReuseGraceSeconds": 30,
    "PasswordResetTokenMinutes": 30,
    "AccountSetupTokenHours": 48,
    "AllowedEmailDomains": [
      "usga.com.br"
    ]
  },
  "App": {
    "PublicBaseUrl": ""
  },
  "Email": {
    "Enabled": false,
    "From": "",
    "FromName": "SIGH",
    "SendDeadlineAlerts": true,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "UseStartTls": true
    },
    "Outbox": {
      "DispatcherEnabled": true,
      "PollIntervalSeconds": 10,
      "BatchSize": 20,
      "MaxAttempts": 5,
      "InitialRetryDelaySeconds": 30,
      "MaxRetryDelaySeconds": 3600
    }
  },
  "RateLimits": {
    "ForgotPassword": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "ResetPassword": {
      "PermitLimit": 10,
      "WindowMinutes": 15
    },
    "Login": {
      "PermitLimit": 10
    }
  },
  "Import": {
    "MaxTerminationPercent": 10,
    "PreviewValidityMinutes": 30,
    "IgnoredManagementUnitCodes": [
      "TRAPAUT"
    ]
  }
}
